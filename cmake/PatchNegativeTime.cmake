# Match native core symmetric rounding when converting negative graph time to samples.
# Upstream GPL notices remain in the patched dependency source.
function(halftrack_patch_negative_time source_dir)
    set(source "${source_dir}/modules/tracktion_graph/tracktion_graph/tracktion_Utility.h")
    set(original "7a646528d5b260e2d681205f2b6220e2632798578b72c3d6c6d393618c71e237")
    set(patched "e711c54e67db07b1f4347986e3c4f062a6851453d0aa0a371448a393abd9482f")
    file(SHA256 "${source}" hash)
    if(hash STREQUAL patched)
        return()
    endif()
    if(NOT hash STREQUAL original)
        message(FATAL_ERROR "Halftrack negative time patch requires pinned source; unexpected SHA256 ${hash}.")
    endif()
    file(READ "${source}" content)
    set(before [=[return static_cast<int64_t> ((timeInSeconds * sampleRate) + 0.5);]=])
    set(after [=[return static_cast<int64_t> ((timeInSeconds * sampleRate) + (timeInSeconds >= 0.0 ? 0.5 : -0.5));]=])
    string(REPLACE "${before}" "${after}" content "${content}")
    string(SHA256 hash "${content}")
    if(NOT hash STREQUAL patched)
        message(FATAL_ERROR "Halftrack negative time patch produced unexpected SHA256 ${hash}.")
    endif()
    string(REGEX REPLACE "\n$" "" configure_content "${content}")
    file(CONFIGURE OUTPUT "${source}" CONTENT "@configure_content@" @ONLY NEWLINE_STYLE LF)
    file(SHA256 "${source}" hash)
    if(NOT hash STREQUAL patched)
        message(FATAL_ERROR "Halftrack negative time patch wrote unexpected SHA256 ${hash}.")
    endif()
endfunction()
