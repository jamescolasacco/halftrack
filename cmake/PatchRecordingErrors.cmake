# The take file lookup returns its errors as the error, not as a file: returning the message string
# converted it into a juce::File named after the message, so a missing or read-only take folder made
# the engine record into a relative path called "The directory...". Applied after the wave input
# start patch. Upstream GPL notices remain in the patched dependency source.
function(halftrack_patch_recording_errors source_dir)
    set(source "${source_dir}/modules/tracktion_engine/playback/devices/tracktion_WaveInputDevice.cpp")
    set(original "3547f2134733cde3032237fbac4852e217067b4dbb9642235128843738f34ac1")
    set(patched "76ca176d4107398e061a85f3db0043043badd13a9065be37c6625ac3ec7b13f7")
    # Later patches of the same file: input placement.
    set(downstream "b7ea47bf3f5680c433197eaa3426c459ffbdf58ae6f1a513708af52d1b8feb2d" "626cda1af31c966d42441f8fde2e8caa97222e2b4fa2bd9e761c816568b57ca7")
    file(SHA256 "${source}" hash)
    if(hash STREQUAL patched OR hash IN_LIST downstream)
        return()
    endif()
    if(NOT hash STREQUAL original)
        message(FATAL_ERROR "Halftrack recording errors patch requires the wave-input-start source; unexpected SHA256 ${hash}.")
    endif()
    file(READ "${source}" content)
    set(before [=[            return TRANS("The directory\nXZZX\ndoesn't exist")
                .replace ("XZZX", targetFile.getParentDirectory().getFullPathName());]=])
    set(after [=[            return tl::unexpected (TRANS("The directory\nXZZX\ndoesn't exist")
                                       .replace ("XZZX", targetFile.getParentDirectory().getFullPathName()));]=])
    string(REPLACE "${before}" "${after}" content "${content}")
    set(before [=[            return TRANS("The directory\nXZZX\n doesn't have write-access")
                .replace ("XZZX", targetFile.getParentDirectory().getFullPathName());]=])
    set(after [=[            return tl::unexpected (TRANS("The directory\nXZZX\n doesn't have write-access")
                                       .replace ("XZZX", targetFile.getParentDirectory().getFullPathName()));]=])
    string(REPLACE "${before}" "${after}" content "${content}")
    set(before [=[            return TRANS("Can't overwrite the existing file:") + "\n" + targetFile.getFullPathName();]=])
    set(after [=[            return tl::unexpected (TRANS("Can't overwrite the existing file:") + "\n" + targetFile.getFullPathName());]=])
    string(REPLACE "${before}" "${after}" content "${content}")
    string(SHA256 hash "${content}")
    if(NOT hash STREQUAL patched)
        message(FATAL_ERROR "Halftrack recording errors patch produced unexpected SHA256 ${hash}.")
    endif()
    string(REGEX REPLACE "\n$" "" configure_content "${content}")
    file(CONFIGURE OUTPUT "${source}" CONTENT "@configure_content@" @ONLY NEWLINE_STYLE LF)
    file(SHA256 "${source}" hash)
    if(NOT hash STREQUAL patched)
        message(FATAL_ERROR "Halftrack recording errors patch wrote unexpected SHA256 ${hash}.")
    endif()
endfunction()
