# Halftrack tempo range and musical-position precision for pinned Tracktion Engine.
# Retains all upstream source notices. Validate both files before writing either.
function(halftrack_patch_tempo_range source_dir)
    set(source0 "${source_dir}/modules/tracktion_engine/model/edit/tracktion_TempoSetting.h")
    set(original0 "5a3e45f0fb9f53846edde6aae349ba38544e0618e45008e4994e2543148dcb56")
    set(patched0 "b5efb441105e6edf8e216fea7c039a7b47331030019de10dad6db9aa3185c30d")
    set(before0 [=[static constexpr double maxBPM = 300.0;]=])
    set(after0 [=[static constexpr double maxBPM = 999.0;]=])
    set(source1 "${source_dir}/modules/tracktion_engine/model/edit/tracktion_TempoSequence.cpp")
    set(original1 "9bad3c89735d810e4fc41d7f6ac77fd422249287d96306525ae79458839fd6ab")
    set(patched1 "c24f67e52af42fa46a551d585825063dde663eb17abe0a2e3236bcebf9037f99")
    set(before1 [=[+ std::abs ((pos.getOffset() - newOffset).inSeconds()) > 0.001)]=])
    set(after1 [=[+ std::abs ((pos.getOffset() - newOffset).inSeconds()) > 1.0e-12)]=])
    foreach(index RANGE 0 1)
        file(SHA256 "${source${index}}" hash)
        if(hash STREQUAL "${patched${index}}")
            set(write${index} FALSE)
            continue()
        endif()
        if(NOT hash STREQUAL "${original${index}}")
            message(FATAL_ERROR "Halftrack tempo patch requires pinned source ${source${index}}; unexpected SHA256 ${hash}.")
        endif()
        file(READ "${source${index}}" content${index})
        string(REPLACE "${before${index}}" "${after${index}}" content${index} "${content${index}}")
        string(SHA256 hash "${content${index}}")
        if(NOT hash STREQUAL "${patched${index}}")
            message(FATAL_ERROR "Halftrack tempo patch produced unexpected SHA256 ${hash}.")
        endif()
        set(write${index} TRUE)
    endforeach()
    foreach(index RANGE 0 1)
        if(write${index})
            string(REGEX REPLACE "\n$" "" configure_content "${content${index}}")
            file(CONFIGURE OUTPUT "${source${index}}" CONTENT "@configure_content@" @ONLY NEWLINE_STYLE LF)
            file(SHA256 "${source${index}}" hash)
            if(NOT hash STREQUAL "${patched${index}}")
                message(FATAL_ERROR "Halftrack tempo patch wrote unexpected SHA256 ${hash}.")
            endif()
        endif()
    endforeach()
endfunction()
